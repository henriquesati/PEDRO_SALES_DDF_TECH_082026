# =============================================================================
# 🔐 CONFIGURAÇÕES DE AMBIENTE - DADOSFERA CASE & AGENT SERVER
# =============================================================================

# Chave de API Google Gemini (Google GenAI / Antigravity SDK)
# Obtenha sua chave gratuitamente em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_gemini_aqui

# Modelo padrão de inferência autônoma
DEFAULT_MODEL=gemini-3.7-flash

# Configurações de Host e Porta do Servidor FastAPI
AGENT_SERVER_HOST=127.0.0.1
AGENT_SERVER_PORT=8000
